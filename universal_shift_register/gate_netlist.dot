digraph "universal_shift_register" {
label="universal_shift_register";
rankdir="LR";
remincross=true;
n6 [ shape=octagon, label="q", color="black", fontcolor="black"];
n7 [ shape=octagon, label="parallel_in", color="black", fontcolor="black"];
n8 [ shape=octagon, label="serial_right", color="black", fontcolor="black"];
n9 [ shape=octagon, label="serial_left", color="black", fontcolor="black"];
n10 [ shape=octagon, label="mode", color="black", fontcolor="black"];
n11 [ shape=octagon, label="reset", color="black", fontcolor="black"];
n12 [ shape=octagon, label="clk", color="black", fontcolor="black"];
c18 [ shape=record, label="{{<p13> ARST|<p14> CLK|<p15> D|<p16> EN}|$10\n$adffe|{<p17> Q}}",  ];
c21 [ shape=record, label="{{<p19> A}|$6_CMP0\n$logic_not|{<p20> Y}}",  ];
v0 [ label="2'01" ];
c23 [ shape=record, label="{{<p19> A|<p22> B}|$5_CMP0\n$eq|{<p20> Y}}",  ];
v1 [ label="2'10" ];
c24 [ shape=record, label="{{<p19> A|<p22> B}|$4_CMP0\n$eq|{<p20> Y}}",  ];
v4 [ label="4'x" ];
c26 [ shape=record, label="{{<p19> A|<p22> B|<p25> S}|$2\n$pmux|{<p20> Y}}",  ];
x2 [ shape=record, style=rounded, label="<s2> 0:0 - 2:2 |<s1> 0:0 - 1:1 |<s0> 0:0 - 0:0 ", color="black", fontcolor="black" ];
x2:e -> c26:p25:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", style="setlinewidth(3)", label=""];
x3 [ shape=record, style=rounded, label="<s4> 3:0 - 11:8 |<s3> 2:0 - 7:5 |<s2> 0:0 - 4:4 |<s1> 0:0 - 3:3 |<s0> 3:1 - 2:0 ", color="black", fontcolor="black" ];
x3:e -> c26:p22:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", style="setlinewidth(3)", label=""];
v5 [ label="2'11" ];
c27 [ shape=record, label="{{<p19> A|<p22> B}|$3_CMP0\n$eq|{<p20> Y}}",  ];
