c27:p20:e -> x2:s2:w [color="black", fontcolor="black", label=""];
c26:p20:e -> c18:p15:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c18:p17:e -> n6:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
