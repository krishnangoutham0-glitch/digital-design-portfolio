 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /OUTPUT 4 "q";
v0x105802b80_0 .net "clk", 0 0, v0x10580a550_0;  1 drivers
v0x105802c20_0 .var "q", 3 0;
v0x10580a4b0_0 .net "reset", 0 0, v0x10580a690_0;  1 drivers
E_0xb7cc54280 .event posedge, v0x10580a4b0_0, v0x105802b80_0;
    .scope S_0x105802a00;
T_0 ;
    %wait E_0xb7cc54280;
    %load/vec4 v0x10580a4b0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 1, 0, 4;
    %assign/vec4 v0x105802c20_0, 0;
    %jmp T_0.1;
T_0.0 ;
