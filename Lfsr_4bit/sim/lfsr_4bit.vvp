    %vpi_call 2 22 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x105805aa0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x10580a550_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x10580a690_0, 0, 1;
    %wait E_0xb7cc54240;
    %wait E_0xb7cc54240;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x10580a690_0, 0, 1;
    %pushi/vec4 20, 0, 32;
T_2.0 %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_2.1, 5;
    %jmp/1 T_2.1, 4;
    %subi 1, 0, 32;
    %wait E_0xb7cc54240;
    %jmp T_2.0;
T_2.1 ;
    %pop/vec4 1;
    %vpi_call 2 36 "$finish" {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x105805aa0;
T_3 ;
