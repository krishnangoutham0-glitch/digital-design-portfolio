    %parti/s 3, 0, 2;
    %load/vec4 v0x105802c20_0;
    %parti/s 1, 3, 3;
    %load/vec4 v0x105802c20_0;
    %parti/s 1, 2, 3;
    %xor;
    %concat/vec4; draw_concat_vec4
    %assign/vec4 v0x105802c20_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x105805aa0;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x10580a550_0;
    %inv;
    %store/vec4 v0x10580a550_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x105805aa0;
T_2 ;
