digraph "ring_counter" {
label="ring_counter";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="q", color="black", fontcolor="black"];
n2 [ shape=octagon, label="reset", color="black", fontcolor="black"];
n3 [ shape=octagon, label="clk", color="black", fontcolor="black"];
c8 [ shape=record, label="{{<p4> ARST|<p5> CLK|<p6> D}|$4\n$adff|{<p7> Q}}",  ];
x0 [ shape=record, style=rounded, label="<s1> 2:0 - 3:1 |<s0> 3:3 - 0:0 ", color="black", fontcolor="black" ];
x0:e -> c8:p6:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c8:p7:e -> n1:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n1:e -> x0:s0:w [color="black", fontcolor="black", label=""];
n1:e -> x0:s1:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> c8:p4:w [color="black", fontcolor="black", label=""];
n3:e -> c8:p5:w [color="black", fontcolor="black", label=""];
}
